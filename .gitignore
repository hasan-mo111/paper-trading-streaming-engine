# dependencies
node_modules/

# logs
*.log
npm-debug.log*

# environment
.env
.env.*
!.env.example

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# build output
dist/
build/

# Supabase local artefacts (never commit a downloaded key dump)
supabase/.branches/
supabase/.temp/

# NOTE: .env and .env.* are ignored above, with .env.example explicitly
# un-ignored. The Supabase service-role key must never reach this repository —
# it bypasses row-level security entirely.
