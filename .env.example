# =============================================================================
#  AETHERON CORE  —  environment template
#  Developed by Eng Hasan Mohamad
# -----------------------------------------------------------------------------
#  Copy to `.env` for local work (or paste into Render → Environment).
#  Every value below has a working default EXCEPT the Supabase credentials:
#  without them the engine runs in LOCAL MODE — candles live in RAM only, and
#  the 50-day Donchian channel is rebuilt from the upstream REST backfill on
#  every restart.
#
#  NOTHING here is ever sent to a client. Only `publicEnv()` in
#  src/config/env.js may leave the process, and it carries no secrets.
# =============================================================================

# ---------------------------------------------------------------- HTTP server
# PORT and HOST are injected automatically by Render — do not set them there.
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info                    # debug | info | warn | error | silent
SHUTDOWN_GRACE_MS=5000
BODY_LIMIT=16kb

# ------------------------------------------------------------------- Supabase
# Required for persistence, remote quota counting and Supabase auth.
# Project URL:  Supabase dashboard → Settings → API → Project URL
# Service key:  Supabase dashboard → Settings → API → service_role
#
# ⚠ THE SERVICE-ROLE KEY IS A MASTER KEY. It bypasses RLS. It must exist only
#   in this process — never in the Android app, never in a git commit.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Abort the boot instead of degrading to in-memory mode.
# Leave false so /health stays green during a database outage.
SUPABASE_REQUIRED=false
SUPABASE_SCHEMA=public

# Daily candles rehydrated at startup. 100 gives a 50-day Donchian channel plus
# plenty of ATR history — lower it and the engine will report WARMING_UP.
BOOTSTRAP_DAILY_CANDLES=100
SUPABASE_UPSERT_BATCH=250
SUPABASE_TIMEOUT_MS=15000

# ----------------------------------------------------------------- Auth
# When true, /api/user/* and /api/stream/* require a valid Supabase token.
AUTH_REQUIRED=true
AUTH_CACHE_TTL_MS=300000
PROFILE_CACHE_TTL_MS=60000

# Development escape hatch: a static token mapping to a local PRO user.
# env.js BLANKS THIS IN PRODUCTION, so a leaked default cannot work there.
DEV_TOKEN=

# ------------------------------------------------------------- Freemium quota
FREE_DAILY_EXECUTIONS=3           # automatic executions a FREE user gets/day
PRO_DAILY_EXECUTIONS=0            # 0 = unlimited
QUOTA_TZ_OFFSET_MIN=0             # shift the daily rollover (e.g. 180 = 03:00)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# ------------------------------------------------------------------ Broker
# paper → simulated fills in-process (safe default)
# mt5   → signed HTTP calls to your MT5 bridge (an EA on a Windows VPS)
BROKER_MODE=paper
BROKER_BASE_URL=
BROKER_TOKEN=
BROKER_TIMEOUT_MS=10000
BROKER_PAPER_LATENCY_MS=40

# Fallback equity when a profile has none. The live balance comes from the
# `profiles` table; this is only the default for a brand-new account.
ACCOUNT_BALANCE=10000
RISK_PERCENT=0.01                 # 0.01 = 1% of balance risked per trade
MAX_LOT=2

# ------------------------------------------------------------------ Strategy
# The Aetheron Universal Strategy. Defaults match the published parameters.
STRATEGY_SYMBOLS=                 # empty = every symbol in the registry
DONCHIAN_ENTRY=50                 # entry breakout lookback (daily candles)
DONCHIAN_EXIT=20                  # trailing-stop lookback (daily candles)
ATR_PERIOD=20
ATR_TIMEFRAME=3600                # ATR is measured on H1
ENTRY_TIMEFRAME=86400             # entries are evaluated on D1 closes
LEG1_PCT=0.25
LEG2_PCT=0.75
LEG1_ATR_MULT=1                   # Leg 1 takes profit at +1 × ATR(20)
STRATEGY_COOLDOWN_MS=3600000
STRATEGY_EXIT_THROTTLE_MS=250
TRAIL_MIN_STEP_POINTS=5
STRATEGY_EXECUTION_ENABLED=true   # false = signals only, never place an order

# ------------------------------------------------------------------ Streaming
STREAM_INTERVAL_MS=400            # price/chart frame cadence
SSE_HEARTBEAT_MS=15000            # keepalive comment — stops proxies dropping us
STATUS_INTERVAL_MS=5000
SSE_MAX_BUFFER_BYTES=1000000      # back-pressure guard per client
SSE_RETRY_MS=3000
SSE_CHAT_BACKLOG=50

# ---------------------------------------------------------------- Persistence
PERSIST_ENABLED=true
PERSIST_FLUSH_MS=2000             # write-behind queue cadence
PERSIST_FORMING_FLUSH_MS=15000    # the forming bar is upserted this often
MAX_CANDLES=100                   # closed candles per series in RAM
SERVE_PUBLIC=true

# --------------------------------------------------------------- Market data
# Defaults target the free MT5-derived feed; override for your own bridge.
UPSTREAM_WS=wss://biquote.io/hubs/tick
UPSTREAM_API=https://biquote.io
UPSTREAM_SYMBOLS=
UPSTREAM_BACKOFF_BASE_MS=1000
UPSTREAM_BACKOFF_MAX_MS=30000
UPSTREAM_PING_EVERY_MS=20000
UPSTREAM_WATCHDOG_MS=300000
UPSTREAM_REST_TIMEOUT_MS=15000

# ------------------------------------------------------------------ Optional
# Telegram chat-ops notifications (bot token stays on the server).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# Optional fixed chat/channel id. When set, the AI analyst can deliver signals
# to this chat even if no device has been paired via /start <deviceId>.
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- AI analyst
# A second, independent reader of the same candles: it sends a multi-timeframe
# snapshot (D1/H4/H1/M15/M5) to an OpenRouter model and publishes the strict
# JSON verdict to the chat stream and (optionally) Telegram.
#
#   GET /api/ai/signal    → status + last signal
#   GET /api/ai/analyze   → run one analysis now (cooldown-limited)
#
# The analyst NEVER places an order. The strategy engine stays the only actor
# that can open or close a position.
AI_SIGNAL_ENABLED=true
OPENROUTER_API_KEY=                # set as a secret in Render → Environment
# `openrouter/free` is the free-models router (always resolves to an available
# free model). Pin a specific id for deterministic behaviour, e.g.
#   nvidia/nemotron-3-ultra-550b-a55b:free
#   thinkingmachines/inkling-small:free
AI_SIGNAL_MODEL=openrouter/free
AI_SIGNAL_SYMBOL=XAUUSD
AI_SIGNAL_INTERVAL_MS=1800000      # automatic cadence (30 min)
AI_SIGNAL_BOOT_DELAY_MS=120000     # wait for candles to land after boot
AI_SIGNAL_MANUAL_COOLDOWN_S=60     # min gap between /api/ai/analyze calls
AI_SIGNAL_TIMEOUT_MS=60000
AI_SIGNAL_MAX_TOKENS=900
AI_SIGNAL_MIN_RR=2                 # reject a BUY/SELL below 1:2
AI_SIGNAL_MAX_ENTRY_DRIFT=0.02     # entry must sit within 2% of the live quote
AI_SIGNAL_BARS_D1=60
AI_SIGNAL_BARS_H4=60
AI_SIGNAL_BARS_H1=80
AI_SIGNAL_BARS_M15=60
AI_SIGNAL_BARS_M5=60
AI_SIGNAL_TELEGRAM=true            # send actionable signals to Telegram
AI_SIGNAL_CHAT_ID=                 # optional; falls back to TELEGRAM_CHAT_ID
